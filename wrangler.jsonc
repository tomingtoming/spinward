{
  // Static assets + a thin edge Worker. Vite builds the site to dist/ and
  // Cloudflare serves it directly; ONLY the root path is routed through the
  // Worker (run_worker_first), which rewrites the OGP meta tags for share
  // URLs (worker/index.ts) and passes everything else straight to assets.
  // `bun run deploy` runs `wrangler deploy`, which uploads the built assets
  // AND activates them as the live deployment (100%) in one step.
  // (`versions upload` only stages a version without promoting it, so the
  // live site would not change — that was a past footgun.) wrangler is pinned
  // in devDependencies so `bun run deploy` always resolves the modern CLI
  // from node_modules, never a stray global.
  // /metric is the usage-funnel sink (src/app/metrics.ts → worker metric()
  // → Analytics Engine dataset spinward_play). docs/metrics.md is the schema.
  "name": "spinward",
  "compatibility_date": "2026-06-17",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/metric"]
  },
  "analytics_engine_datasets": [
    { "binding": "PLAY", "dataset": "spinward_play" }
  ],
  // Workers Logs: the [metric] line per batch is the liveness signal for the
  // pipeline (a dataset that quietly stops looks exactly like nobody visiting).
  "observability": { "enabled": true }
}
