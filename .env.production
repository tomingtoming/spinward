# Production build pins the published Tokyo data release so that a plain
# `bun run build` (Workers Builds on main: bun run build && npx wrangler deploy)
# ships the same city as the audited metro package. Shell variables with the
# same names take precedence, so vite.metro.config.mjs builds are unaffected.
# Release history: docs/development-handoff.md, docs/metro-production-delivery.md.
VITE_METRO_RELEASE=releases/ce65ac50fdc0bb7e8ddc3c7ce8de3f9243c5d2129ecefd4ce8a304574fa3c8f4.json
VITE_METRO_DATA_ROOT=https://data.spinward.toming.app/
